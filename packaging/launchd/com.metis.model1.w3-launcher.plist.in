<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- runs as root: no UserName key by design -->
<dict>
	<key>Label</key>
	<string>com.metis.model1.w3-launcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/com.metis.model1.w3-launcher</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>METIS_W3_PACKAGE_INSTANCE</key>
		<string>w3-public-synthetic-v1/install-v1</string>
		<key>PATH</key>
		<string>/usr/bin:/bin</string>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>Sockets</key>
	<dict>
		<key>LauncherListener</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/metis-model1/w3-launcher.sock</string>
			<key>SockPathOwner</key>
			<integer>499</integer>
			<key>SockPathGroup</key>
			<integer>499</integer>
			<key>SockPathMode</key>
			<integer>384</integer>
		</dict>
	</dict>
	<key>StandardOutPath</key>
	<string>/Library/Logs/MetisModel1/w3-launcher.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/MetisModel1/w3-launcher.stderr.log</string>
</dict>
</plist>
