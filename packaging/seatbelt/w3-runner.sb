(version 1)
(deny default)
(deny network*)
(deny process-fork)
(allow process-exec
  (literal "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/runtime/node"))
(allow file-read*
  (literal "/dev/null")
  (subpath "/System/Library")
  (subpath "/usr/lib")
  (subpath "/private/var/db/dyld")
  (subpath "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/runtime")
  (subpath "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/capsule")
  (subpath "/Library/Application Support/MetisModel1/runs/active"))
(allow file-read-data (literal "/"))
(allow file-read-metadata
  (literal "/")
  (literal "/Library")
  (literal "/Library/Application Support")
  (literal "/Library/Application Support/MetisModel1")
  (literal "/Library/Application Support/MetisModel1/releases")
  (literal "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1")
  (literal "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/runtime")
  (literal "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/capsule")
  (literal "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/capsule/.metis-oracle")
  (literal "/Library/Application Support/MetisModel1/runs")
  (literal "/Library/Application Support/MetisModel1/runs/active"))
(deny file-write*
  (subpath "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/runtime")
  (subpath "/Library/Application Support/MetisModel1/releases/w3-public-synthetic-v1/capsule"))
(allow file-write*
  (subpath "/Library/Application Support/MetisModel1/runs/active"))
(allow sysctl-read)
(allow mach-lookup)
