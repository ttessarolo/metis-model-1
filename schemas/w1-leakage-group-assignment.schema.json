{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/w1-leakage-group-assignment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "status", "source_revision", "input_pins", "counts", "population_claim_eligible", "group_reason", "assignments", "manifest_hash"],
  "properties": {"schema_version": {"const": 1}, "manifest_id": {"const": "w1/leakage-group-assignment-v1"}, "status": {"const": "correlated_single_group_evidence_only"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "input_pins": {"$ref": "#/$defs/pins"}, "counts": {"$ref": "#/$defs/counts"}, "population_claim_eligible": {"const": false}, "group_reason": {"const": "whole_tenant_dependency_closure"}, "assignments": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/assignment"}}, "manifest_hash": {"$ref": "#/$defs/hash"}},
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "pins": {"type": "object", "additionalProperties": false, "required": ["benchmark_plan", "closure", "blocker_map"], "properties": {"benchmark_plan": {"$ref": "#/$defs/hash"}, "closure": {"$ref": "#/$defs/hash"}, "blocker_map": {"$ref": "#/$defs/hash"}}}, "counts": {"type": "object", "additionalProperties": false, "required": ["tasks_in", "tasks_out", "task_ids_distinct", "leakage_groups_distinct", "population_claim_groups_available", "minimum_population_for_claim", "gaps"], "properties": {"tasks_in": {"const": 30}, "tasks_out": {"const": 30}, "task_ids_distinct": {"const": 30}, "leakage_groups_distinct": {"const": 1}, "population_claim_groups_available": {"const": 1}, "minimum_population_for_claim": {"const": 563}, "gaps": {"const": 0}}}, "assignment": {"type": "object", "additionalProperties": false, "required": ["task_id", "family", "source_path", "source_blob_oid", "leakage_group_id", "normalized_ast_signature", "normalized_ir_signature", "dependency_closure", "symbol_set", "property_family", "provenance_parent", "language_epoch"], "properties": {"task_id": {"type": "string", "pattern": "^slice-0001/f[1-6]-0[1-5]$"}, "family": {"enum": ["F-1", "F-2", "F-3", "F-4", "F-5", "F-6"]}, "source_path": {"type": "string", "minLength": 1}, "source_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "leakage_group_id": {"$ref": "#/$defs/hash"}, "normalized_ast_signature": {"const": null}, "normalized_ir_signature": {"const": null}, "dependency_closure": {"const": "whole-tenant"}, "symbol_set": {"const": null}, "property_family": {"const": null}, "provenance_parent": {"const": null}, "language_epoch": {"const": "0.43"}}}}
}
