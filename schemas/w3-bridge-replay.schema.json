{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/w3-bridge-replay.schema.json",
  "title": "W3 production capsule two-process retained replay report",
  "oneOf": [
    { "$ref": "#/$defs/qualified" },
    { "$ref": "#/$defs/blocked" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nativeEvidence": {
      "const": {
        "path": "manifests/w3-native-loader-evidence.json",
        "manifest_sha256": "sha256:a84ec4511009102f1c2cc23604a4147606e34030809537d1528fd49032f331f6"
      }
    },
    "nullableHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "processRootCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 512 },
        "directories": { "type": "integer", "minimum": 1, "maximum": 512 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 }
      }
    },
    "runtimeRootCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 8 },
        "directories": { "type": "integer", "minimum": 1, "maximum": 8 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 }
      }
    },
    "trustedRootCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "directories": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      }
    },
    "publicationRootCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 128 },
        "directories": { "type": "integer", "minimum": 1, "maximum": 128 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      }
    },
    "holderRootCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "directories", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "directories": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 3221225472 }
      }
    },
    "sealedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "kind", "logical_root", "anchor", "locator", "counts",
        "physical_roster_sha256", "normalized_roster_sha256",
        "snapshot_first_sha256", "snapshot_second_sha256", "sealed", "root_id"
      ],
      "properties": {
        "state": { "const": "sealed" },
        "kind": {
          "enum": [
            "production-process-root", "production-runtime-root", "production-trusted-root",
            "qualification-publication-partial-root", "replay-holder-root"
          ]
        },
        "logical_root": { "type": "string", "minLength": 1, "maxLength": 128 },
        "anchor": { "enum": ["run-root", "artifact-root", "replay-artifact-root"] },
        "locator": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
        "counts": { "type": "object" },
        "physical_roster_sha256": { "$ref": "#/$defs/hash" },
        "normalized_roster_sha256": { "$ref": "#/$defs/hash" },
        "snapshot_first_sha256": { "$ref": "#/$defs/hash" },
        "snapshot_second_sha256": { "$ref": "#/$defs/hash" },
        "sealed": { "const": true },
        "root_id": { "$ref": "#/$defs/hash" }
      }
    },
    "productionProcessRoot": {
      "allOf": [
        { "$ref": "#/$defs/sealedRoot" },
        {
          "properties": {
            "kind": { "const": "production-process-root" },
            "logical_root": { "const": "process" },
            "anchor": { "const": "run-root" },
            "counts": { "$ref": "#/$defs/processRootCounts" }
          }
        }
      ]
    },
    "productionRuntimeRoot": {
      "allOf": [
        { "$ref": "#/$defs/sealedRoot" },
        {
          "properties": {
            "kind": { "const": "production-runtime-root" },
            "logical_root": { "const": "runtime" },
            "anchor": { "const": "run-root" },
            "counts": { "$ref": "#/$defs/runtimeRootCounts" }
          }
        }
      ]
    },
    "productionTrustedRoot": {
      "allOf": [
        { "$ref": "#/$defs/sealedRoot" },
        {
          "properties": {
            "kind": { "const": "production-trusted-root" },
            "logical_root": { "const": "trusted" },
            "anchor": { "const": "run-root" },
            "counts": { "$ref": "#/$defs/trustedRootCounts" }
          }
        }
      ]
    },
    "publicationPartialRoot": {
      "allOf": [
        { "$ref": "#/$defs/sealedRoot" },
        {
          "properties": {
            "kind": { "const": "qualification-publication-partial-root" },
            "logical_root": { "const": "qualification-publication-partial" },
            "anchor": { "const": "artifact-root" },
            "counts": { "$ref": "#/$defs/publicationRootCounts" }
          }
        }
      ]
    },
    "replayHolderRoot": {
      "allOf": [
        { "$ref": "#/$defs/sealedRoot" },
        {
          "properties": {
            "kind": { "const": "replay-holder-root" },
            "logical_root": { "const": "replay-holder" },
            "anchor": { "const": "replay-artifact-root" },
            "counts": { "$ref": "#/$defs/holderRootCounts" }
          }
        }
      ]
    },
    "unmeasurableRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "kind", "logical_root", "anchor", "locator",
        "creation_observed", "reason", "root_id"
      ],
      "properties": {
        "state": { "const": "unmeasurable" },
        "kind": {
          "enum": [
            "production-process-root", "production-runtime-root", "production-trusted-root",
            "qualification-publication-partial-root", "replay-holder-root"
          ]
        },
        "logical_root": { "type": "string", "minLength": 1, "maxLength": 128 },
        "anchor": { "enum": ["run-root", "artifact-root", "replay-artifact-root"] },
        "locator": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
        "creation_observed": { "const": true },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "root_id": { "$ref": "#/$defs/hash" }
      }
    },
    "productionProcessUnmeasurable": {
      "allOf": [
        { "$ref": "#/$defs/unmeasurableRoot" },
        {
          "properties": {
            "kind": { "const": "production-process-root" },
            "logical_root": { "const": "process" },
            "anchor": { "const": "run-root" }
          }
        }
      ]
    },
    "productionRuntimeUnmeasurable": {
      "allOf": [
        { "$ref": "#/$defs/unmeasurableRoot" },
        {
          "properties": {
            "kind": { "const": "production-runtime-root" },
            "logical_root": { "const": "runtime" },
            "anchor": { "const": "run-root" }
          }
        }
      ]
    },
    "productionTrustedUnmeasurable": {
      "allOf": [
        { "$ref": "#/$defs/unmeasurableRoot" },
        {
          "properties": {
            "kind": { "const": "production-trusted-root" },
            "logical_root": { "const": "trusted" },
            "anchor": { "const": "run-root" }
          }
        }
      ]
    },
    "publicationPartialUnmeasurable": {
      "allOf": [
        { "$ref": "#/$defs/unmeasurableRoot" },
        {
          "properties": {
            "kind": { "const": "qualification-publication-partial-root" },
            "logical_root": { "const": "qualification-publication-partial" },
            "anchor": { "const": "artifact-root" }
          }
        }
      ]
    },
    "replayHolderUnmeasurable": {
      "allOf": [
        { "$ref": "#/$defs/unmeasurableRoot" },
        {
          "properties": {
            "kind": { "const": "replay-holder-root" },
            "logical_root": { "const": "replay-holder" },
            "anchor": { "const": "replay-artifact-root" }
          }
        }
      ]
    },
    "productionProcessBlockedRoot": {
      "oneOf": [
        { "$ref": "#/$defs/productionProcessRoot" },
        { "$ref": "#/$defs/productionProcessUnmeasurable" }
      ]
    },
    "productionRuntimeBlockedRoot": {
      "oneOf": [
        { "$ref": "#/$defs/productionRuntimeRoot" },
        { "$ref": "#/$defs/productionRuntimeUnmeasurable" }
      ]
    },
    "productionTrustedBlockedRoot": {
      "oneOf": [
        { "$ref": "#/$defs/productionTrustedRoot" },
        { "$ref": "#/$defs/productionTrustedUnmeasurable" }
      ]
    },
    "publicationPartialBlockedRoot": {
      "oneOf": [
        { "$ref": "#/$defs/publicationPartialRoot" },
        { "$ref": "#/$defs/publicationPartialUnmeasurable" }
      ]
    },
    "replayHolderBlockedRoot": {
      "oneOf": [
        { "$ref": "#/$defs/replayHolderRoot" },
        { "$ref": "#/$defs/replayHolderUnmeasurable" }
      ]
    },
    "retainedRoot": {
      "oneOf": [
        { "$ref": "#/$defs/productionProcessRoot" },
        { "$ref": "#/$defs/productionRuntimeRoot" },
        { "$ref": "#/$defs/productionTrustedRoot" },
        { "$ref": "#/$defs/publicationPartialRoot" },
        { "$ref": "#/$defs/replayHolderRoot" },
        { "$ref": "#/$defs/productionProcessUnmeasurable" },
        { "$ref": "#/$defs/productionRuntimeUnmeasurable" },
        { "$ref": "#/$defs/productionTrustedUnmeasurable" },
        { "$ref": "#/$defs/publicationPartialUnmeasurable" },
        { "$ref": "#/$defs/replayHolderUnmeasurable" }
      ]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gc_policy", "delete_attempts", "retained_roots"],
      "properties": {
        "status": { "const": "cleanup_deferred" },
        "gc_policy": { "const": "separately_ratified_quiescent_exclusive_v1" },
        "delete_attempts": { "const": 0 },
        "retained_roots": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/retainedRoot" }
        }
      }
    },
    "qualifiedChildCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gc_policy", "delete_attempts", "retained_roots"],
      "properties": {
        "status": { "const": "cleanup_deferred" },
        "gc_policy": { "const": "separately_ratified_quiescent_exclusive_v1" },
        "delete_attempts": { "const": 0 },
        "retained_roots": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "$ref": "#/$defs/productionProcessRoot" },
            { "$ref": "#/$defs/productionRuntimeRoot" },
            { "$ref": "#/$defs/productionTrustedRoot" }
          ],
          "items": false
        }
      }
    },
    "qualifiedReplayCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gc_policy", "delete_attempts", "retained_roots"],
      "properties": {
        "status": { "const": "cleanup_deferred" },
        "gc_policy": { "const": "separately_ratified_quiescent_exclusive_v1" },
        "delete_attempts": { "const": 0 },
        "retained_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/replayHolderRoot" }],
          "items": false
        }
      }
    },
    "blockedChildCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gc_policy", "delete_attempts", "retained_roots"],
      "properties": {
        "status": { "const": "cleanup_deferred" },
        "gc_policy": { "const": "separately_ratified_quiescent_exclusive_v1" },
        "delete_attempts": { "const": 0 },
        "retained_roots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/productionProcessBlockedRoot" },
            { "$ref": "#/$defs/productionRuntimeBlockedRoot" },
            { "$ref": "#/$defs/productionTrustedBlockedRoot" },
            { "$ref": "#/$defs/publicationPartialBlockedRoot" }
          ],
          "items": false
        }
      }
    },
    "blockedReplayCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gc_policy", "delete_attempts", "retained_roots"],
      "properties": {
        "status": { "const": "cleanup_deferred" },
        "gc_policy": { "const": "separately_ratified_quiescent_exclusive_v1" },
        "delete_attempts": { "const": 0 },
        "retained_roots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1,
          "prefixItems": [{ "$ref": "#/$defs/replayHolderBlockedRoot" }],
          "items": false
        }
      }
    },
    "physicalRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_index", "qualification_manifest_sha256", "report_bytes_sha256", "cleanup"],
      "properties": {
        "run_index": { "enum": [1, 2] },
        "qualification_manifest_sha256": { "$ref": "#/$defs/hash" },
        "report_bytes_sha256": { "$ref": "#/$defs/hash" },
        "cleanup": { "$ref": "#/$defs/qualifiedChildCleanup" }
      }
    },
    "qualifiedObservedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_index", "status", "qualification_manifest_sha256", "report_bytes_sha256", "cleanup"
      ],
      "properties": {
        "run_index": { "enum": [1, 2] },
        "status": { "const": "qualified" },
        "qualification_manifest_sha256": { "$ref": "#/$defs/hash" },
        "report_bytes_sha256": { "$ref": "#/$defs/hash" },
        "cleanup": { "$ref": "#/$defs/qualifiedChildCleanup" }
      }
    },
    "blockedObservedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_index", "status", "qualification_manifest_sha256", "report_bytes_sha256", "cleanup"
      ],
      "properties": {
        "run_index": { "enum": [1, 2] },
        "status": { "const": "blocked" },
        "qualification_manifest_sha256": { "type": "null" },
        "report_bytes_sha256": { "$ref": "#/$defs/hash" },
        "cleanup": { "$ref": "#/$defs/blockedChildCleanup" }
      }
    },
    "noReportObservedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_index", "status", "qualification_manifest_sha256", "report_bytes_sha256", "cleanup"
      ],
      "properties": {
        "run_index": { "enum": [1, 2] },
        "status": { "const": "no-report" },
        "qualification_manifest_sha256": { "type": "null" },
        "report_bytes_sha256": { "type": "null" },
        "cleanup": { "type": "null" }
      }
    },
    "observedRun": {
      "oneOf": [
        { "$ref": "#/$defs/qualifiedObservedRun" },
        { "$ref": "#/$defs/blockedObservedRun" },
        { "$ref": "#/$defs/noReportObservedRun" }
      ]
    },
    "observedRun1": {
      "allOf": [
        { "$ref": "#/$defs/observedRun" },
        { "properties": { "run_index": { "const": 1 } } }
      ]
    },
    "observedRun2": {
      "allOf": [
        { "$ref": "#/$defs/observedRun" },
        { "properties": { "run_index": { "const": 2 } } }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^artifacts/(?:[A-Za-z0-9][A-Za-z0-9._-]*/)*[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "qualified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "replay_id", "status", "claim", "authority_manifest_sha256",
        "runs", "normalized_projection_sha256", "capsule_manifest_sha256", "counts",
        "roles", "nonce_model", "artifacts", "native_evidence", "non_claims", "cleanup",
        "manifest_sha256"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "replay_id": { "const": "w3-f1-f3-production-capsule-replay-v3" },
        "status": { "const": "replay-qualified" },
        "claim": { "const": "three_ratified_smoke_specs_two_process_replay_only_no_accuracy_claim" },
        "authority_manifest_sha256": { "$ref": "#/$defs/hash" },
        "runs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/physicalRun" },
                { "properties": { "run_index": { "const": 1 } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/physicalRun" },
                { "properties": { "run_index": { "const": 2 } } }
              ]
            }
          ],
          "items": false
        },
        "normalized_projection_sha256": { "$ref": "#/$defs/hash" },
        "capsule_manifest_sha256": { "$ref": "#/$defs/hash" },
        "counts": {
          "const": {
            "fresh_processes": 2, "physical_invocations": 10, "semantic_identities": 5,
            "candidates": 3, "artifacts_per_run": 5, "gaps": 0
          }
        },
        "roles": {
          "const": { "author": 2, "before": 2, "after": 2, "mutated": 2, "fixed": 2 }
        },
        "nonce_model": { "const": "excluded_execution_metadata_and_retained_root_physical_identity_only" },
        "artifacts": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "native_evidence": { "$ref": "#/$defs/nativeEvidence" },
        "non_claims": {
          "const": [
            "executed_preimage_authority=false", "no_w1_15_of_15_claim",
            "no_f4_f5_f6_claim", "no_benchmark_v1_claim",
            "no_w5_claim", "no_semantic_accuracy_claim"
          ]
        },
        "cleanup": { "$ref": "#/$defs/qualifiedReplayCleanup" },
        "manifest_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "replay_id", "status", "claim", "reason", "observed_runs",
        "native_evidence", "cleanup"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "replay_id": { "const": "w3-f1-f3-production-capsule-replay-v3" },
        "status": { "const": "blocked" },
        "claim": { "const": "no_replay_claim" },
        "reason": { "type": "string", "minLength": 1 },
        "observed_runs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "prefixItems": [
            { "$ref": "#/$defs/observedRun1" },
            { "$ref": "#/$defs/observedRun2" }
          ],
          "items": false
        },
        "native_evidence": { "$ref": "#/$defs/nativeEvidence" },
        "cleanup": { "$ref": "#/$defs/blockedReplayCleanup" }
      }
    }
  }
}
