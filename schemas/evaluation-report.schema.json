{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/evaluation-report.schema.json",
  "title": "Metis Model 1 offline A/B/C/D evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "all_observations_post_repair_pass", "prompt_roster_hash", "denominator", "config_identity", "variants", "family_breakdown", "paired_deltas", "failure_taxonomy", "critical_failures", "identity_hashes", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "complete"},
    "all_observations_post_repair_pass": {"type": "boolean"},
    "prompt_roster_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "denominator": {"$ref": "#/$defs/denominator"},
    "config_identity": {"$ref": "#/$defs/config_identity"},
    "variants": {"$ref": "#/$defs/variant_map"},
    "family_breakdown": {"$ref": "#/$defs/family_variant_map"},
    "paired_deltas": {
      "type": "object", "additionalProperties": false, "required": ["B-A", "C-A", "D-B", "D-C"],
      "properties": {"B-A": {"$ref": "#/$defs/paired"}, "C-A": {"$ref": "#/$defs/paired"}, "D-B": {"$ref": "#/$defs/paired"}, "D-C": {"$ref": "#/$defs/paired"}}
    },
    "failure_taxonomy": {"$ref": "#/$defs/variant_counts"},
    "critical_failures": {"$ref": "#/$defs/counts"},
    "identity_hashes": {"$ref": "#/$defs/identity_hashes"},
    "observations": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["successes", "total", "denominator", "rate", "wilson95"],
      "properties": {
        "successes": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1},
        "wilson95": {"type": "object", "additionalProperties": false, "required": ["lower", "upper"], "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}}
      }
    },
    "family_score": {"type": "object", "additionalProperties": false, "required": ["first_shot", "post_repair"], "properties": {"first_shot": {"$ref": "#/$defs/metric"}, "post_repair": {"$ref": "#/$defs/metric"}}},
    "family_variant_map": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"$ref": "#/$defs/family_map_entry"}, "B": {"$ref": "#/$defs/family_map_entry"}, "C": {"$ref": "#/$defs/family_map_entry"}, "D": {"$ref": "#/$defs/family_map_entry"}}},
    "variant": {"type": "object", "additionalProperties": false, "required": ["denominator", "first_shot", "post_repair", "family_breakdown", "failure_taxonomy", "critical_failures"], "properties": {"denominator": {"type": "integer", "minimum": 1}, "first_shot": {"$ref": "#/$defs/metric"}, "post_repair": {"$ref": "#/$defs/metric"}, "family_breakdown": {"$ref": "#/$defs/family_map_entry"}, "failure_taxonomy": {"$ref": "#/$defs/counts"}, "critical_failures": {"$ref": "#/$defs/counts"}}},
    "family_map_entry": {"type": "object", "propertyNames": {"pattern": "^F-[1-6]$"}, "additionalProperties": {"$ref": "#/$defs/family_score"}},
    "variant_map": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"$ref": "#/$defs/variant"}, "B": {"$ref": "#/$defs/variant"}, "C": {"$ref": "#/$defs/variant"}, "D": {"$ref": "#/$defs/variant"}}},
    "variant_counts": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"$ref": "#/$defs/counts"}, "B": {"$ref": "#/$defs/counts"}, "C": {"$ref": "#/$defs/counts"}, "D": {"$ref": "#/$defs/counts"}}},
    "denominator": {"type": "object", "additionalProperties": false, "required": ["tasks", "observations", "expected_observations", "distinct_task_ids", "in", "out", "distinct_task", "gaps", "filtered", "conditional", "policy"], "properties": {"tasks": {"type": "integer", "minimum": 1}, "observations": {"type": "integer", "minimum": 1}, "expected_observations": {"type": "integer", "minimum": 1}, "distinct_task_ids": {"type": "integer", "minimum": 1}, "in": {"type": "integer", "minimum": 1}, "out": {"type": "integer", "minimum": 1}, "distinct_task": {"type": "integer", "minimum": 1}, "gaps": {"const": 0}, "filtered": {"const": 0}, "conditional": {"const": false}, "policy": {"const": "all_tasks_unfiltered"}}},
    "config_identity": {"type": "object", "additionalProperties": false, "required": ["sampling_hash", "reasoning_mode", "context_budget", "repair_budget", "prompt_roster_hash", "variants"], "properties": {"sampling_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reasoning_mode": {"type": "string", "minLength": 1}, "context_budget": {"type": "integer", "minimum": 0}, "repair_budget": {"type": "integer", "minimum": 0, "maximum": 2}, "prompt_roster_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "variants": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"$ref": "#/$defs/mode"}, "B": {"$ref": "#/$defs/mode"}, "C": {"$ref": "#/$defs/mode"}, "D": {"$ref": "#/$defs/mode"}}}}},
    "mode": {"type": "object", "additionalProperties": false, "required": ["context_enabled", "compiler_loop", "adapter_enabled"], "properties": {"context_enabled": {"type": "boolean"}, "compiler_loop": {"type": "boolean"}, "adapter_enabled": {"type": "boolean"}}},
    "paired_metric": {"type": "object", "additionalProperties": false, "required": ["left_successes", "right_successes", "denominator", "left_rate", "right_rate", "delta_successes", "delta_rate", "discordant_left_wins", "discordant_right_wins", "discordant_total", "sign_test_p_value"], "properties": {"left_successes": {"type": "integer", "minimum": 0}, "right_successes": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "left_rate": {"type": "number", "minimum": 0, "maximum": 1}, "right_rate": {"type": "number", "minimum": 0, "maximum": 1}, "delta_successes": {"type": "integer"}, "delta_rate": {"type": "number", "minimum": -1, "maximum": 1}, "discordant_left_wins": {"type": "integer", "minimum": 0}, "discordant_right_wins": {"type": "integer", "minimum": 0}, "discordant_total": {"type": "integer", "minimum": 0}, "sign_test_p_value": {"type": "number", "minimum": 0, "maximum": 1}}},
    "paired": {"type": "object", "additionalProperties": false, "required": ["first_shot", "post_repair"], "properties": {"first_shot": {"$ref": "#/$defs/paired_metric"}, "post_repair": {"$ref": "#/$defs/paired_metric"}}},
    "identity_hashes": {"type": "object", "additionalProperties": false, "required": ["shared_identity_hash", "seed", "base_model_hash", "dataset_manifest_hash", "compiler_hash", "benchmark_hash", "runtime_hash", "adapter_hash"], "properties": {"shared_identity_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "seed": {"type": "integer"}, "base_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "dataset_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "compiler_hash": {"type": "string", "pattern": "^(git:[0-9a-f]{40}|[0-9a-f]{64})$"}, "benchmark_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "runtime_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "adapter_hash": {"type": "object", "additionalProperties": false, "required": ["off", "on"], "properties": {"off": {"const": "none"}, "on": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["seed", "base_model_hash", "adapter_hash", "dataset_manifest_hash", "compiler_hash", "benchmark_hash", "runtime_hash"], "properties": {"seed": {"type": "integer"}, "base_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "adapter_hash": {"type": "string", "pattern": "^(none|[0-9a-f]{64})$"}, "dataset_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "compiler_hash": {"type": "string", "pattern": "^(git:[0-9a-f]{40}|[0-9a-f]{64})$"}, "benchmark_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "runtime_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "config": {"type": "object", "additionalProperties": false, "required": ["prompt_hash", "sampling_hash", "reasoning_mode", "context_budget", "repair_budget", "context_enabled", "compiler_loop", "adapter_enabled"], "properties": {"prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sampling_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reasoning_mode": {"type": "string", "minLength": 1}, "context_budget": {"type": "integer", "minimum": 0}, "repair_budget": {"type": "integer", "minimum": 0, "maximum": 2}, "context_enabled": {"type": "boolean"}, "compiler_loop": {"type": "boolean"}, "adapter_enabled": {"type": "boolean"}}},
    "outcomes": {"type": "object", "propertyNames": {"enum": ["parse", "link", "validate", "compile", "semantic", "patch_minimality", "diagnostic", "ir", "wire", "golden", "migration_pair", "ast", "human"]}, "additionalProperties": {"enum": ["pass", "fail", "not_applicable"]}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["output_sha256", "first_shot_oracles", "post_repair_oracles"], "properties": {"output_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "first_shot_oracles": {"$ref": "#/$defs/evidence_map"}, "post_repair_oracles": {"$ref": "#/$defs/evidence_map"}}},
    "evidence_map": {"type": "object", "propertyNames": {"enum": ["parse", "link", "validate", "compile", "semantic", "patch_minimality", "diagnostic", "ir", "wire", "golden", "migration_pair", "ast", "human"]}, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["task_id", "family", "variant", "leakage_group", "config", "identity", "evidence", "first_shot_success", "post_repair_success", "first_shot_end_to_end", "post_repair_end_to_end", "repair_cycles", "first_shot_outcomes", "post_repair_outcomes", "tool_failure", "critical_failures", "failure_category"], "properties": {"task_id": {"type": "string", "minLength": 1}, "family": {"enum": ["F-1", "F-2", "F-3", "F-4", "F-5", "F-6"]}, "variant": {"enum": ["A", "B", "C", "D"]}, "leakage_group": {"type": "string", "minLength": 1}, "config": {"$ref": "#/$defs/config"}, "identity": {"$ref": "#/$defs/identity"}, "evidence": {"$ref": "#/$defs/evidence"}, "first_shot_success": {"type": "boolean"}, "post_repair_success": {"type": "boolean"}, "first_shot_end_to_end": {"type": "boolean"}, "post_repair_end_to_end": {"type": "boolean"}, "repair_cycles": {"type": "integer", "minimum": 0, "maximum": 2}, "first_shot_outcomes": {"$ref": "#/$defs/outcomes"}, "post_repair_outcomes": {"$ref": "#/$defs/outcomes"}, "tool_failure": {"type": "boolean"}, "critical_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "failure_category": {"type": ["string", "null"], "enum": ["misunderstanding", "syntax", "linking", "validation", "compile", "semantic", "nonminimal_or_regressive", "context_or_retrieval", "loop_or_tool", "benchmark_oracle", "invented_identifier", "unknown", null]}}}
  }
}
