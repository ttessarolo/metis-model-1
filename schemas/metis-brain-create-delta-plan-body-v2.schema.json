{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/metis-brain-create-delta-plan-body-v2.schema.json",
  "title": "Metis Brain compact CREATE delta plan body v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["o"],
  "properties": {
    "o": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "handle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "requirementHandles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "q", "s", "n"],
      "properties": {
        "k": {"const": "a"},
        "q": {"$ref": "#/$defs/requirementHandles"},
        "s": {"$ref": "#/$defs/handle"},
        "n": {"$ref": "#/$defs/handle"}
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "q", "s", "v"],
      "properties": {
        "k": {"const": "s"},
        "q": {"$ref": "#/$defs/requirementHandles"},
        "s": {"$ref": "#/$defs/handle"},
        "v": {"$ref": "#/$defs/handle"}
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "q", "n"],
      "properties": {
        "k": {"const": "d"},
        "q": {"$ref": "#/$defs/requirementHandles"},
        "n": {"$ref": "#/$defs/handle"}
      }
    },
    "expand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "q", "s", "r", "w"],
      "properties": {
        "k": {"const": "x"},
        "q": {"$ref": "#/$defs/requirementHandles"},
        "s": {"$ref": "#/$defs/handle"},
        "r": {"$ref": "#/$defs/handle"},
        "w": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/handle"}
        }
      }
    },
    "operation": {
      "anyOf": [
        {"$ref": "#/$defs/attach"},
        {"$ref": "#/$defs/set"},
        {"$ref": "#/$defs/remove"},
        {"$ref": "#/$defs/expand"}
      ]
    }
  }
}
