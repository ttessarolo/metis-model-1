{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/w1-held-out-family-map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "status", "source_revision", "input_pins", "counts", "families", "manifest_hash"],
  "properties": {"schema_version": {"const": 1}, "manifest_id": {"const": "w1/held-out-family-map-v1"}, "status": {"const": "allocation_only_not_sealed"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "input_pins": {"$ref": "#/$defs/pins"}, "counts": {"$ref": "#/$defs/counts"}, "families": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/family"}}, "manifest_hash": {"$ref": "#/$defs/hash"}},
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "pins": {"type": "object", "additionalProperties": false, "required": ["benchmark_plan", "accuracy_target", "blocker_map"], "properties": {"benchmark_plan": {"$ref": "#/$defs/hash"}, "accuracy_target": {"$ref": "#/$defs/hash"}, "blocker_map": {"$ref": "#/$defs/hash"}}}, "counts": {"type": "object", "additionalProperties": false, "required": ["families_in", "families_out", "families_distinct", "allocated_tasks", "target_frozen_tasks", "gaps"], "properties": {"families_in": {"const": 6}, "families_out": {"const": 6}, "families_distinct": {"const": 6}, "allocated_tasks": {"const": 30}, "target_frozen_tasks": {"const": 600}, "gaps": {"const": 0}}}, "family": {"type": "object", "additionalProperties": false, "required": ["family", "criticality", "held_out_rule", "allocated_task_ids", "allocated_task_count", "target_frozen_task_count", "status"], "properties": {"family": {"enum": ["F-1", "F-2", "F-3", "F-4", "F-5", "F-6"]}, "criticality": {"type": "string", "minLength": 1}, "held_out_rule": {"type": "string", "minLength": 1}, "allocated_task_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^slice-0001/f[1-6]-0[1-5]$"}}, "allocated_task_count": {"const": 5}, "target_frozen_task_count": {"enum": [80, 90, 100, 110]}, "status": {"const": "allocation_only_not_sealed"}}}}
}
