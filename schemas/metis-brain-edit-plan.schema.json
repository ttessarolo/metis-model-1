{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/metis-brain-edit-plan.schema.json",
  "title": "Metis Brain host-reference EditPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "context_revision", "source_revision", "target_ref", "base_ref", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "metis-brain-edit-plan/v1"},
    "context_revision": {"$ref": "#/$defs/hash"},
    "source_revision": {"$ref": "#/$defs/hash"},
    "target_ref": {"$ref": "#/$defs/ref"},
    "base_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^hostref:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "target_ref", "anchor_ref", "payload_ref", "preimage_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "kind": {"enum": ["insert", "replace", "delete"]},
        "target_ref": {"$ref": "#/$defs/ref"},
        "anchor_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "payload_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "preimage_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
