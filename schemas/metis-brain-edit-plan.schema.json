{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/metis-brain-edit-plan.schema.json",
  "title": "Metis Brain typed host-reference EditPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "context_revision",
    "workspace_base_revision",
    "edit_source_revision",
    "target_ref",
    "base_ref",
    "basis_ref",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "contract_id": {"const": "metis-brain-edit-plan/v2"},
    "context_revision": {"$ref": "#/$defs/hash"},
    "workspace_base_revision": {"$ref": "#/$defs/hash"},
    "edit_source_revision": {"$ref": "#/$defs/hash"},
    "target_ref": {"$ref": "#/$defs/ref"},
    "base_ref": {"$ref": "#/$defs/ref"},
    "basis_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/replace"},
          {"$ref": "#/$defs/insert"},
          {"$ref": "#/$defs/delete"}
        ]
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^hostref:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "replace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "node_ref", "payload_ref"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "kind": {"const": "replace"},
        "node_ref": {"$ref": "#/$defs/ref"},
        "payload_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "insert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "slot_ref", "payload_ref"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "kind": {"const": "insert"},
        "slot_ref": {"$ref": "#/$defs/ref"},
        "payload_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "kind", "delete_ref"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 31},
        "kind": {"const": "delete"},
        "delete_ref": {"$ref": "#/$defs/ref"}
      }
    }
  }
}
