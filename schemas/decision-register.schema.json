{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/decision-register.schema.json",
  "title": "Metis Model 1 open decision register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "canonical_decision_log", "open_decisions"],
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "canonical_decision_log": { "type": "string", "minLength": 1 },
    "open_decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "owner",
        "deadline_wave",
        "blocks",
        "evidence_required",
        "resolution"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^O-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "ratified", "deferred", "rejected"] },
        "owner": { "type": "string", "minLength": 1 },
        "deadline_wave": { "type": "string", "pattern": "^W[0-9]+$" },
        "blocks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^W[0-9]+$" }
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "resolution": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "ratified" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "resolution": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
