{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/metis-brain-create-endpoint-spec.schema.json",
  "title": "Metis Brain private typed CREATE endpoint specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "endpoint"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "metis-brain-create-endpoint-spec/v1"},
    "endpoint": {"$ref": "#/$defs/endpoint"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "qualifiedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
    },
    "safeText": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2048,
      "pattern": "^[^\\\"\\\\\\r\\n\\u0000-\\u001f\\u007f]*$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "value": {
      "oneOf": [
        {"$ref": "#/$defs/literalValue"},
        {"$ref": "#/$defs/boolValue"},
        {"$ref": "#/$defs/listRefValue"},
        {"$ref": "#/$defs/contextValue"},
        {"$ref": "#/$defs/inputValue"},
        {"$ref": "#/$defs/argumentValue"},
        {"$ref": "#/$defs/valuesValue"}
      ]
    },
    "literalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lexical", "value"],
      "properties": {
        "kind": {"const": "lit"},
        "lexical": {"enum": ["text", "number", "duration", "name", "time"]},
        "value": {"type": ["string", "number"]}
      }
    },
    "boolValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {"kind": {"const": "bool"}, "value": {"type": "boolean"}}
    },
    "listRefValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {"kind": {"const": "list_ref"}, "name": {"$ref": "#/$defs/qualifiedIdentifier"}}
    },
    "contextValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "segments"],
      "properties": {"kind": {"const": "ctx"}, "segments": {"$ref": "#/$defs/segments"}}
    },
    "inputValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {"kind": {"const": "input"}, "name": {"$ref": "#/$defs/identifier"}}
    },
    "argumentValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {"kind": {"const": "arg"}, "name": {"$ref": "#/$defs/identifier"}}
    },
    "valuesValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": {"const": "vals"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/safeText"}
        }
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["input", "arg", "attr", "field", "ctx", "time", "name"]},
        "name": {"$ref": "#/$defs/identifier"},
        "segments": {"$ref": "#/$defs/segments"}
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["compare", "size", "and", "or", "not"]},
        "left": {"$ref": "#/$defs/operand"},
        "op": {"enum": ["truthy", "eq", "neq", "in", "not_in", "contains", "not_contains", "contains_any", "contains_no", "exists", "empty", "not_empty", "starts_with", "gt", "gte", "lt", "lte"]},
        "right": {"$ref": "#/$defs/value"},
        "items": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"$ref": "#/$defs/guard"}},
        "item": {"$ref": "#/$defs/guard"}
      }
    },
    "title": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "literal"}, "value": {"$ref": "#/$defs/safeText"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parts", "fallback"],
          "properties": {
            "kind": {"const": "context_parts"},
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "value"],
                    "properties": {"kind": {"const": "text"}, "value": {"$ref": "#/$defs/safeText"}}
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "segments"],
                    "properties": {"kind": {"const": "ctx"}, "segments": {"$ref": "#/$defs/segments"}}
                  }
                ]
              }
            },
            "fallback": {"$ref": "#/$defs/safeText"}
          }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["eq", "in", "contains", "gt", "gte", "lte", "similar", "within", "exists", "match", "ids", "and", "or", "group"]},
        "field": {"$ref": "#/$defs/identifier"},
        "value": {"$ref": "#/$defs/value"},
        "target": {"$ref": "#/$defs/value"},
        "amount": {"$ref": "#/$defs/literalValue"},
        "profile": {"$ref": "#/$defs/identifier"},
        "form": {"enum": ["field", "record"]},
        "membership": {"enum": ["contains", "not_contains", "contains_any", "contains_no", "has", "has_any", "has_no"]},
        "fuzzy": {"oneOf": [{"type": "boolean"}, {"const": "auto"}, {"type": "integer", "minimum": 1, "maximum": 10000}]},
        "min": {"type": "integer", "minimum": 0, "maximum": 10000},
        "boost": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1000000}, {"$ref": "#/$defs/identifier"}]},
        "guard": {"$ref": "#/$defs/guard"},
        "segments": {"$ref": "#/$defs/segments"},
        "items": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"$ref": "#/$defs/predicate"}},
        "strategy": {"enum": ["any", "best", "best_plus", "at_least"]},
        "coefficient": {"$ref": "#/$defs/identifier"},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": {"enum": ["include", "exclude", "promote"]},
        "where": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/predicate"}},
        "presets": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/qualifiedIdentifier"}}
      },
      "oneOf": [{"required": ["where"]}, {"required": ["presets"]}]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "direction"],
      "properties": {
        "by": {"enum": ["field", "relevance", "similarity", "count"]},
        "direction": {"enum": ["ascending", "descending"]},
        "field": {"$ref": "#/$defs/identifier"},
        "target": {"$ref": "#/$defs/value"},
        "guard": {"$ref": "#/$defs/guard"}
      }
    },
    "groupBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "member_order", "member_limit", "having"],
      "properties": {
        "fields": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/identifier"}},
        "member_order": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/order"}},
        "member_limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
        "having": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "value"],
              "properties": {
                "op": {"enum": ["eq", "gt", "gte", "lt", "lte"]},
                "value": {"type": "integer", "minimum": 0, "maximum": 10000}
              }
            }
          ]
        }
      }
    },
    "metaEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "ui_preset"}, "value": {"$ref": "#/$defs/safeText"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "value"],
          "properties": {"kind": {"const": "entry"}, "key": {"$ref": "#/$defs/identifier"}, "value": {"$ref": "#/$defs/value"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "entries"],
          "properties": {
            "kind": {"const": "object"},
            "name": {"$ref": "#/$defs/identifier"},
            "entries": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/metaEntry"}}
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinned", "view_all", "meta", "meta_per_item"],
      "properties": {
        "pinned": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/value"}]},
        "view_all": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name"],
              "properties": {
                "kind": {"enum": ["endpoint", "arg"]},
                "name": {"$ref": "#/$defs/qualifiedIdentifier"}
              }
            }
          ]
        },
        "meta": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/metaEntry"}},
        "meta_per_item": {"type": "boolean"}
      }
    },
    "outputStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["deduplicate", "max", "shuffle", "limit", "limit_per", "order"]},
        "field": {"$ref": "#/$defs/identifier"},
        "count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "op": {"enum": ["eq", "gt", "gte", "lt", "lte"]},
        "value": {"$ref": "#/$defs/value"},
        "orders": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/order"}}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "trigger", "mode"],
      "properties": {
        "kind": {"enum": ["direct", "materialized"]},
        "target": {"$ref": "#/$defs/qualifiedIdentifier"},
        "target_kind": {"enum": ["block", "endpoint"]},
        "trigger": {"enum": ["empty", "error", "below", "no_valid_block", "page_blocks_below", "nested_flat_items_below", "on_error"]},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 10000},
        "mode": {"enum": ["substitute", "append"]}
      }
    },
    "returnFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "steps", "fallbacks"],
      "properties": {
        "projection": {"$ref": "#/$defs/identifier"},
        "steps": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/outputStep"}},
        "fallbacks": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/fallback"}}
      }
    },
    "fetchSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "catalog"],
          "properties": {"kind": {"const": "catalog"}, "catalog": {"$ref": "#/$defs/identifier"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "segments"],
          "properties": {"kind": {"const": "context"}, "segments": {"$ref": "#/$defs/segments"}}
        }
      ]
    },
    "fetchCardinality": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "value"],
          "properties": {
            "mode": {"const": "total"},
            "value": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "page"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "value"],
          "properties": {
            "mode": {"const": "page_default"},
            "value": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        }
      ]
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "cardinality", "over_fetch", "alias", "title", "activation", "presentation", "clauses", "group_by", "order", "output"],
      "properties": {
        "from": {"$ref": "#/$defs/fetchSource"},
        "cardinality": {"$ref": "#/$defs/fetchCardinality"},
        "over_fetch": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 2, "maximum": 16}]},
        "alias": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "title": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/title"}]},
        "activation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/guard"}]},
        "presentation": {"$ref": "#/$defs/presentation"},
        "clauses": {"type": "array", "maxItems": 480, "items": {"$ref": "#/$defs/clause"}},
        "group_by": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/groupBy"}]},
        "order": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/order"}},
        "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/returnFlow"}]}
      },
      "allOf": [
        {
          "if": {
            "required": ["over_fetch"],
            "properties": {"over_fetch": {"type": "integer"}}
          },
          "then": {
            "properties": {
              "cardinality": {
                "type": "object",
                "required": ["mode", "value"],
                "properties": {"mode": {"const": "total"}}
              }
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "type", "default"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "required": {"type": "boolean"},
        "type": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identifier"}]},
        "default": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/value"}]}
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "block"],
      "properties": {
        "kind": {"enum": ["direct", "instance", "matrix"]},
        "block": {"$ref": "#/$defs/identifier"},
        "alias": {"$ref": "#/$defs/identifier"},
        "title": {"$ref": "#/$defs/title"},
        "args": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {"name": {"$ref": "#/$defs/identifier"}, "value": {"$ref": "#/$defs/value"}}
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "title", "args"],
            "properties": {
              "alias": {"$ref": "#/$defs/identifier"},
              "title": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/title"}]},
              "args": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "value"],
                  "properties": {"name": {"$ref": "#/$defs/identifier"}, "value": {"$ref": "#/$defs/value"}}
                }
              }
            }
          }
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters", "title", "activation", "presentation", "fetches", "blocks", "uses", "output"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "parameters": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/parameter"}},
        "title": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/title"}]},
        "activation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/guard"}]},
        "presentation": {"$ref": "#/$defs/presentation"},
        "fetches": {"type": "array", "maxItems": 36, "items": {"$ref": "#/$defs/fetch"}},
        "blocks": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/container"}},
        "uses": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/use"}},
        "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/returnFlow"}]}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "activation", "empty", "presentation", "fetches", "blocks", "uses", "output"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "title": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/title"}]},
        "activation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/guard"}]},
        "empty": {"type": "boolean"},
        "presentation": {"$ref": "#/$defs/presentation"},
        "fetches": {"type": "array", "maxItems": 36, "items": {"$ref": "#/$defs/fetch"}},
        "blocks": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/container"}},
        "uses": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/use"}},
        "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/returnFlow"}]}
      }
    },
    "contextBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "fetch"],
          "properties": {"kind": {"const": "fetch"}, "name": {"$ref": "#/$defs/identifier"}, "fetch": {"$ref": "#/$defs/fetch"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "value", "transformer"],
          "properties": {
            "kind": {"const": "transform"},
            "name": {"$ref": "#/$defs/identifier"},
            "value": {"$ref": "#/$defs/value"},
            "transformer": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    },
    "endpointParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout", "expires", "paginate"],
      "properties": {
        "timeout": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": {"enum": ["scale", "duration"]},
                "value": {"type": "string", "minLength": 1, "maxLength": 32}
              }
            }
          ]
        },
        "expires": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "guard", "else"],
              "properties": {
                "value": {"$ref": "#/$defs/literalValue"},
                "guard": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/guard"}]},
                "else": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/literalValue"}]}
              }
            }
          ]
        },
        "paginate": {"enum": [null, "snapshot", "windowed"]}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required", "not_empty", "default"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {"$ref": "#/$defs/identifier"},
        "required": {"type": "boolean"},
        "not_empty": {"type": "boolean"},
        "default": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/value"}]}
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "guard"],
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "guard": {"$ref": "#/$defs/guard"}}
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["without_input", "without_output"],
      "properties": {
        "without_input": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/qualifiedIdentifier"}},
        "without_output": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/qualifiedIdentifier"}}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference", "params", "inputs", "needs_time", "attributes", "input_pipeline", "output_pipeline", "inheritance", "context", "blocks", "variants", "output"],
      "properties": {
        "name": {"$ref": "#/$defs/qualifiedIdentifier"},
        "reference": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/safeText"}]},
        "params": {"$ref": "#/$defs/endpointParams"},
        "inputs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/input"}},
        "needs_time": {"type": "boolean"},
        "attributes": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/attribute"}},
        "input_pipeline": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/qualifiedIdentifier"}},
        "output_pipeline": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/qualifiedIdentifier"}},
        "inheritance": {"$ref": "#/$defs/inheritance"},
        "context": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/contextBinding"}},
        "blocks": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/container"}},
        "variants": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/variant"}},
        "output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/returnFlow"}]}
      }
    }
  }
}
