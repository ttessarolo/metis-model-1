{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/catalog-maintenance-successor-freeze.schema.json",
  "title": "Metis Model 1 catalog prompt-cure successor freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "freeze_id",
    "status",
    "preimage_commit",
    "preimage_tree",
    "remote",
    "remote_ref",
    "probe_manifest_sha256",
    "probe_manifest_file_sha256",
    "probe_schema_sha256",
    "bound_inputs",
    "catalog_pin",
    "retrieval",
    "checkpoint",
    "runtime",
    "run_dir",
    "model",
    "counts",
    "tasks",
    "model_outputs_observed",
    "training_authorized",
    "nonclaims",
    "freeze_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "freeze_id": { "const": "catalog-maintenance-successor-freeze/v1" },
    "status": { "const": "frozen_before_model_output" },
    "preimage_commit": { "$ref": "#/$defs/gitOid" },
    "preimage_tree": { "$ref": "#/$defs/gitOid" },
    "remote": { "const": "origin" },
    "remote_ref": { "type": "string", "pattern": "^refs/heads/codex/" },
    "probe_manifest_sha256": { "$ref": "#/$defs/hash" },
    "probe_manifest_file_sha256": { "$ref": "#/$defs/hash" },
    "probe_schema_sha256": { "$ref": "#/$defs/hash" },
    "bound_inputs": {
      "type": "array",
      "minItems": 29,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundInput" }
    },
    "catalog_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree", "manifest_sha256", "verification"],
      "properties": {
        "revision": { "const": "5e112f9148f40e7e792052e896c5a9efe8eaf0a2" },
        "tree": { "const": "41c7a2b6890fa42d8123bd93f6560d0b9bfae8af" },
        "manifest_sha256": { "$ref": "#/$defs/hash" },
        "verification": { "const": "verified_local_cooperative" }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "receipt_file_sha256",
        "receipt_self_sha256",
        "curated"
      ],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/hash" },
        "receipt_file_sha256": { "$ref": "#/$defs/hash" },
        "receipt_self_sha256": { "$ref": "#/$defs/hash" },
        "curated": { "$ref": "#/$defs/curated" }
      }
    },
    "checkpoint": { "type": "object", "minProperties": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "successor_runner",
        "common_runner",
        "worker_script",
        "worker_python",
        "checkpoint_report",
        "sandbox_policy_sha256"
      ],
      "properties": {
        "successor_runner": { "type": "object", "minProperties": 1 },
        "common_runner": { "type": "object", "minProperties": 1 },
        "worker_script": { "type": "object", "minProperties": 1 },
        "worker_python": { "type": "object", "minProperties": 1 },
        "checkpoint_report": { "type": "object", "minProperties": 1 },
        "sandbox_policy_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "run_dir": { "const": "artifacts/catalog-maintenance-successor-v1" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "adapter_enabled",
        "temperature",
        "seed",
        "max_tokens",
        "max_repair_cycles"
      ],
      "properties": {
        "family": { "const": "Qwen3.8" },
        "adapter_enabled": { "const": false },
        "temperature": { "const": 0 },
        "seed": { "const": 17 },
        "max_tokens": { "const": 512 },
        "max_repair_cycles": { "const": 2 }
      }
    },
    "counts": {
      "const": { "cases_in": 8, "cases_out": 8, "cases_distinct": 8, "gaps": 0 }
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/task" }
    },
    "model_outputs_observed": { "const": false },
    "training_authorized": { "const": false },
    "nonclaims": {
      "const": [
        "no_accuracy_claim",
        "no_promotion_claim",
        "no_training_authority",
        "no_tenant_dataset_authority",
        "no_independent_accuracy_denominator",
        "no_live_execution_attestation",
        "nonpromotable"
      ]
    },
    "freeze_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "boundInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "git_blob_oid"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "git_blob_oid": { "$ref": "#/$defs/gitOid" }
      }
    },
    "curated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "size", "nature", "value", "receipt_sha256"],
      "properties": {
        "kind": { "const": "enum" },
        "size": { "const": 1 },
        "nature": { "const": "editorial" },
        "value": { "const": "Curated" },
        "receipt_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user"] },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "mode",
        "root_id",
        "messages",
        "messages_sha256",
        "expected_skeleton",
        "expected_skeleton_sha256",
        "expected_describe_receipt_sha256",
        "retrieval",
        "model_output_observed"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "family": { "enum": ["F-1", "F-2", "F-3"] },
        "mode": { "enum": ["author", "edit", "repair"] },
        "root_id": { "type": "string", "minLength": 1 },
        "messages": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/message" },
                { "properties": { "role": { "const": "system" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/message" },
                { "properties": { "role": { "const": "user" } } }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "messages_sha256": { "$ref": "#/$defs/hash" },
        "expected_skeleton": { "type": "object", "minProperties": 1 },
        "expected_skeleton_sha256": { "$ref": "#/$defs/hash" },
        "expected_describe_receipt_sha256": { "$ref": "#/$defs/hash" },
        "retrieval": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/curated" }]
        },
        "model_output_observed": { "const": false }
      }
    }
  }
}
