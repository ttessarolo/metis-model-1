{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/video-grounding-task.schema.json",
  "title": "Video semantic grounding benchmark task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "leakage_group", "family", "request", "scope", "target", "expected", "behavior", "semantic_refs", "oracle", "patch_regions", "criticality", "provenance", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^V-[1-7]-[0-9]{2}$"},
    "leakage_group": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "family": {"enum": ["V-1", "V-2", "V-3", "V-4", "V-5", "V-6", "V-7"]},
    "request": {"type": "string", "minLength": 1, "maxLength": 4096},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["tenant_ref", "catalog_ref"],
      "properties": {
        "tenant_ref": {"$ref": "#/$defs/opaque"},
        "catalog_ref": {"$ref": "#/$defs/opaque"}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["source", "required_fragments", "forbidden_fragments"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 16384},
        "required_fragments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "forbidden_fragments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["catalog_refs", "field_refs", "literal_refs", "semantic_refs"],
      "properties": {
        "catalog_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
        "field_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
        "literal_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "semantic_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
      }
    },
    "behavior": {"enum": ["resolve", "clarify", "unsupported"]},
    "semantic_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "oracle": {
      "type": "object", "additionalProperties": false, "required": ["parse", "link", "validate", "compile", "semantic"],
      "properties": {
        "parse": {"const": true}, "link": {"const": true}, "validate": {"const": true}, "compile": {"const": true},
        "semantic": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    },
    "patch_regions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+/-]+$"}},
    "criticality": {"enum": ["normal", "critical"]},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source_revision", "constraint_revision", "grammar_revision", "toolchain_revision", "base_model_ref", "adapter_ref", "tokenizer_ref"],
      "properties": {
        "source_revision": {"$ref": "#/$defs/hash"}, "constraint_revision": {"$ref": "#/$defs/hash"},
        "grammar_revision": {"$ref": "#/$defs/hash"}, "toolchain_revision": {"$ref": "#/$defs/hash"},
        "base_model_ref": {"$ref": "#/$defs/opaque"}, "adapter_ref": {"type": ["string", "null"], "maxLength": 128},
        "tokenizer_ref": {"$ref": "#/$defs/opaque"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["max_tokens", "max_repair_cycles", "timeout_ms"],
      "properties": {"max_tokens": {"type": "integer", "minimum": 1, "maximum": 65536}, "max_repair_cycles": {"const": 2}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
