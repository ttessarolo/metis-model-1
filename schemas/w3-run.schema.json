{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/w3-run.schema.json",
  "title": "Registered W3 public-synthetic run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "claim", "generator_version", "receipt_mode", "benchmark_manifest_sha256", "source_register_sha256", "split_manifest_id", "accepted_records", "rejected", "counts", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"const": "w3-public-synthetic-run-v1"},
    "claim": {"const": "no_accuracy_claim"},
    "generator_version": {"const": "w3-public-synthetic-v1"},
    "receipt_mode": {"enum": ["fixture-policy", "real-runner-envelopes"]},
    "benchmark_manifest_sha256": {"$ref": "#/$defs/hash"},
    "source_register_sha256": {"$ref": "#/$defs/hash"},
    "split_manifest_id": {"$ref": "#/$defs/hash"},
    "accepted_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/accepted"}},
    "rejected": {"type": "array", "items": {"$ref": "#/$defs/rejected"}},
    "counts": {"$ref": "#/$defs/counts"},
    "manifest_sha256": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"receipt_mode": {"const": "fixture-policy"}}},
      "then": {
        "properties": {
          "accepted_records": {
            "items": {
              "properties": {
                "oracle_evidence": {
                  "properties": {
                    "receipt_mode": {"const": "fixture-policy"},
                    "runtime_receipt": {"$ref": "#/$defs/runtimeReceiptPolicy"}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"receipt_mode": {"const": "real-runner-envelopes"}}},
      "then": {
        "properties": {
          "accepted_records": {
            "items": {
              "properties": {
                "oracle_evidence": {
                  "properties": {
                    "receipt_mode": {"const": "real-runner-envelopes"},
                    "runtime_receipt": {"$ref": "#/$defs/runtimeReceiptReal"}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hashList": {"type": "array", "items": {"$ref": "#/$defs/hash"}, "uniqueItems": true},
    "runtimeReceiptPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "candidate_sha256", "adapter_identity_sha256", "toolchain_revision", "toolchain_tree", "node", "node_path", "loader_path", "loader_sha256", "loader_flags", "runner_path", "node_binary_sha256", "runner_sha256", "tooling_package_sha256", "tooling_lock_sha256", "node_modules_sha256", "sandbox_exec_path", "oracle_policy_version", "oracle_policy_sha256", "execution_policy_sha256", "runtime_receipt_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "adapter_identity_sha256": {"$ref": "#/$defs/hash"},
        "toolchain_revision": {"const": "a2dde2b191f6b78c2003d74875560da782470968"},
        "toolchain_tree": {"const": "75473e26deff4084a0eb077a4c3e27d52dc07998"},
        "node": {"const": "v22.22.3"},
        "node_path": {"const": "node://v22.22.3"},
        "loader_path": {"const": "snapshot://a2dde2b191f6b78c2003d74875560da782470968/75473e26deff4084a0eb077a4c3e27d52dc07998/.metis-oracle/native_ts_loader.mjs"},
        "loader_sha256": {"const": "sha256:45e3557ce7ee345e2bca7de603c2ef8bc21aa2adb3f305d3f1cf6ee445273fee"},
        "loader_flags": {"const": ["--disable-warning=ExperimentalWarning", "--experimental-loader"]},
        "runner_path": {"const": "snapshot://a2dde2b191f6b78c2003d74875560da782470968/75473e26deff4084a0eb077a4c3e27d52dc07998/.metis-oracle/runner.ts"},
        "node_binary_sha256": {"const": "sha256:5d9d3872911e2340a43b707962e68143de8a4e8d54628845c0c4f2de1fb7cd5c"},
        "runner_sha256": {"const": "sha256:772baa27e981f611681330bc463aef2ebe06b5f4a83ef2a0313ccf66b6dfef5d"},
        "tooling_package_sha256": {"const": "sha256:f8130a67f948720b339695fae614f32185610f762d69b85ff600f08971f2fb80"},
        "tooling_lock_sha256": {"const": "sha256:fed109b62f300ed824201f4b167d700072008b0b4a817cbb512a2eee32edc9fb"},
        "node_modules_sha256": {"const": "sha256:1cea5f2f0371d3c57b9ef9787707bc1079f88dc697c7be2c6c247e4018f6e463"},
        "sandbox_exec_path": {"const": "sandbox-exec:///usr/bin/sandbox-exec"},
        "oracle_policy_version": {"const": "2"},
        "oracle_policy_sha256": {"const": "sha256:deb8f45c9dfc2f336dbfb6f69a13e599a51929864ede8229969fa7f6e03f40aa"},
        "execution_policy_sha256": {"$ref": "#/$defs/hash"},
        "runtime_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "realExecutionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_sha256", "adapter_identity_sha256", "semantic_spec_sha256", "execution_profile_sha256", "family", "role", "source_sha256", "request", "envelope", "artifact_path", "artifact_sha256", "result_sha256", "diagnostics_sha256", "ast_sha256", "ir_sha256", "runtime_sha256", "runtime_identity", "metis_status_sha256", "receipt_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "adapter_identity_sha256": {"$ref": "#/$defs/hash"},
        "semantic_spec_sha256": {"$ref": "#/$defs/hash"},
        "execution_profile_sha256": {"$ref": "#/$defs/hash"},
        "family": {"enum": ["F-1", "F-2", "F-3"]},
        "role": {"enum": ["author", "before", "after", "mutated", "fixed"]},
        "source_sha256": {"$ref": "#/$defs/hash"},
        "request": {"type": "object"},
        "envelope": {"type": "object"},
        "artifact_path": {"type": "string", "pattern": "^artifacts/w3-production/.+\\.json$"},
        "artifact_sha256": {"$ref": "#/$defs/hash"},
        "result_sha256": {"$ref": "#/$defs/hash"},
        "diagnostics_sha256": {"$ref": "#/$defs/hash"},
        "ast_sha256": {"$ref": "#/$defs/hash"},
        "ir_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "runtime_sha256": {"$ref": "#/$defs/hash"},
        "runtime_identity": {"type": "object"},
        "metis_status_sha256": {"$ref": "#/$defs/hash"},
        "receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "runtimeReceiptReal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "receipt_mode", "candidate_sha256", "adapter_identity_sha256", "semantic_registry_sha256", "semantic_spec_sha256", "execution_profile_sha256", "executions", "runtime_receipt_sha256"],
      "properties": {
        "schema_version": {"const": 3},
        "receipt_mode": {"const": "real-runner-envelopes"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "adapter_identity_sha256": {"$ref": "#/$defs/hash"},
        "semantic_registry_sha256": {"$ref": "#/$defs/hash"},
        "semantic_spec_sha256": {"$ref": "#/$defs/hash"},
        "execution_profile_sha256": {"$ref": "#/$defs/hash"},
        "executions": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/realExecutionReceipt"}},
        "runtime_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "runtimeReceipt": {
      "oneOf": [
        {"$ref": "#/$defs/runtimeReceiptPolicy"},
        {"$ref": "#/$defs/runtimeReceiptReal"}
      ]
    },
    "accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "candidate", "candidate_sha256", "source_record_sha256", "dataset_example", "text_sha256", "ast_sha256", "ir_sha256", "component_roots", "leakage_group", "oracle_evidence", "oracle_result_sha256", "semantic_result_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "candidate": {"type": "object"},
        "candidate_sha256": {"$ref": "#/$defs/hash"},
        "source_record_sha256": {"$ref": "#/$defs/hash"},
        "dataset_example": {
          "type": "object",
          "required": ["schema_version", "example_id", "task_family", "input", "output", "messages", "metis", "provenance", "sensitivity", "split", "positive", "status", "oracles"],
          "properties": {
            "schema_version": {"const": 1}, "example_id": {"$ref": "#/$defs/hash"},
            "task_family": {"enum": ["F-1", "F-2", "F-3"]}, "input": {}, "output": {"type": "object"},
            "messages": {"type": "array", "minItems": 3}, "metis": {"type": "object"}, "provenance": {"type": "object"},
            "sensitivity": {"const": "public"}, "split": {"enum": ["train", "dev", "internal_test"]},
            "positive": {"const": true}, "status": {"const": "accepted"}, "oracles": {"type": "array", "minItems": 1}
          }
        },
        "text_sha256": {"$ref": "#/$defs/hash"},
        "ast_sha256": {"$ref": "#/$defs/hash"},
        "ir_sha256": {"$ref": "#/$defs/hash"},
        "component_roots": {"$ref": "#/$defs/hashList"},
        "leakage_group": {"$ref": "#/$defs/hash"},
        "oracle_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "status", "family", "candidate_sha256", "adapter_identity_sha256", "receipt_mode", "runtime_receipt", "predicates", "evidence"],
          "properties": {
            "schema_version": {"const": 1}, "status": {"const": "pass"}, "family": {"enum": ["F-1", "F-2", "F-3"]},
            "candidate_sha256": {"$ref": "#/$defs/hash"}, "adapter_identity_sha256": {"$ref": "#/$defs/hash"},
            "receipt_mode": {"enum": ["fixture-policy", "real-runner-envelopes"]},
            "runtime_receipt": {"$ref": "#/$defs/runtimeReceipt"},
            "predicates": {"type": "object", "minProperties": 5}, "evidence": {"type": "object", "minProperties": 8}
          },
          "allOf": [
            {
              "if": {"properties": {"receipt_mode": {"const": "fixture-policy"}}},
              "then": {"properties": {"runtime_receipt": {"$ref": "#/$defs/runtimeReceiptPolicy"}}}
            },
            {
              "if": {"properties": {"receipt_mode": {"const": "real-runner-envelopes"}}},
              "then": {"properties": {"runtime_receipt": {"$ref": "#/$defs/runtimeReceiptReal"}}}
            }
          ]
        },
        "oracle_result_sha256": {"$ref": "#/$defs/hash"},
        "semantic_result_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "rejected": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "reason"],
      "properties": {"candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "reason": {"type": "string", "minLength": 1}}
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["in", "out", "distinct", "rejected", "gaps"],
      "properties": {
        "in": {"type": "integer", "minimum": 1}, "out": {"type": "integer", "minimum": 1},
        "distinct": {"type": "integer", "minimum": 1}, "rejected": {"type": "integer", "minimum": 0},
        "gaps": {"type": "integer", "minimum": 0}
      }
    }
  }
}
