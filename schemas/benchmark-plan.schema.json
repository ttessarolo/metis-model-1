{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/benchmark-plan.schema.json",
  "title": "Metis Model 1 benchmark family and allocation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "source_revision",
    "language_version",
    "sensitivity",
    "census",
    "families",
    "leakage",
    "slice_30"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]+$" },
    "status": { "const": "ratified" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "language_version": { "const": "0.43" },
    "sensitivity": { "const": "internal" },
    "census": { "$ref": "#/$defs/census" },
    "families": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/family" }
    },
    "leakage": { "$ref": "#/$defs/leakage" },
    "slice_30": { "$ref": "#/$defs/slice" }
  },
  "$defs": {
    "census": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_files",
        "lines",
        "endpoint_files",
        "property_files",
        "catalog_files",
        "transformer_files",
        "settings_files",
        "lib_files",
        "validator_errors",
        "validator_warnings",
        "validation_command",
        "evidence_refs"
      ],
      "properties": {
        "tenant_files": { "type": "integer", "minimum": 1 },
        "lines": { "type": "integer", "minimum": 1 },
        "endpoint_files": { "type": "integer", "minimum": 1 },
        "property_files": { "type": "integer", "minimum": 1 },
        "catalog_files": { "type": "integer", "minimum": 0 },
        "transformer_files": { "type": "integer", "minimum": 0 },
        "settings_files": { "type": "integer", "minimum": 0 },
        "lib_files": { "type": "integer", "minimum": 0 },
        "validator_errors": { "type": "integer", "minimum": 0 },
        "validator_warnings": { "type": "integer", "minimum": 0 },
        "validation_command": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "criticality",
        "source_denominator",
        "held_out_rule",
        "required_oracles",
        "allocated_tasks"
      ],
      "properties": {
        "id": { "enum": ["F-1", "F-2", "F-3", "F-4", "F-5", "F-6"] },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["author", "edit", "repair", "review", "migrate", "explain"] },
        "criticality": { "enum": ["medium_high", "high", "critical"] },
        "source_denominator": { "type": "string", "minLength": 1 },
        "held_out_rule": { "type": "string", "minLength": 1 },
        "required_oracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allocated_tasks": { "const": 5 }
      }
    },
    "leakage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "group_if_shared", "signature_fields", "unresolved_closure_policy"],
      "properties": {
        "status": { "const": "ratified_fail_closed" },
        "group_if_shared": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "signature_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unresolved_closure_policy": {
          "const": "exclude_from_frozen_benchmark"
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "seal_blockers", "tasks"],
      "properties": {
        "status": { "const": "allocated_not_sealed" },
        "seal_blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tasks": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": { "$ref": "#/$defs/task_allocation" }
        }
      }
    },
    "task_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "family",
        "mode",
        "source_path",
        "source_blob_oid",
        "intended_oracles",
        "leakage_group_status"
      ],
      "properties": {
        "task_id": { "type": "string", "pattern": "^slice-0001/f[1-6]-0[1-5]$" },
        "family": { "enum": ["F-1", "F-2", "F-3", "F-4", "F-5", "F-6"] },
        "mode": { "enum": ["author", "edit", "repair", "review", "migrate", "explain"] },
        "source_path": { "type": "string", "pattern": "^examples/play-prod-v2/.+\\.metis$" },
        "source_blob_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "intended_oracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "leakage_group_status": { "const": "pending_dependency_closure" }
      }
    }
  }
}
