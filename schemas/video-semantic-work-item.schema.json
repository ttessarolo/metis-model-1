{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/video-semantic-work-item.schema.json",
  "title": "Video semantic enrichment work item",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item_id", "node_kind", "canonical_locator", "technical", "candidate", "editorial_rules", "evidence_refs", "ambiguities", "author", "reviewer"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"$ref": "#/$defs/hash"},
    "node_kind": {"enum": ["catalog", "field", "value", "list_entry"]},
    "canonical_locator": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_commit", "path", "catalog", "field_path", "literal", "preimage_sha256"],
      "properties": {
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"$ref": "#/$defs/relative_path"},
        "catalog": {"$ref": "#/$defs/opaque"},
        "field_path": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "literal": {"type": ["string", "null"], "maxLength": 1024},
        "preimage_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "technical": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "modifiers", "domain_kind", "declared_cardinality", "observed_cardinality"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "modifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "domain_kind": {"enum": ["inline", "enum", "list", "open", "none"]},
        "declared_cardinality": {"type": ["integer", "null"], "minimum": 0},
        "observed_cardinality": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["means", "aka", "review_state"],
      "properties": {
        "means": {"type": ["string", "null"], "maxLength": 4096},
        "aka": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "review_state": {"enum": ["unannotated", "draft", "reviewed"]}
      }
    },
    "editorial_rules": {
      "type": "object", "additionalProperties": false, "required": ["include_when", "exclude_when", "scope", "dependencies", "constraint_gaps"],
      "properties": {
        "include_when": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "exclude_when": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "scope": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "constraint_gaps": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/opaque"}},
    "ambiguities": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "author": {"$ref": "#/$defs/opaque"},
    "reviewer": {"type": ["string", "null"], "maxLength": 128}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaque": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@+/-]+$"}
  }
}
