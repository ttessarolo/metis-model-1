{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metis-model1.local/schemas/w1-slice-30-oracle-receipts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "status", "source_revision", "input_pins", "counts", "future_protected_role_receipt_target", "tasks", "manifest_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"const": "w1/slice-30-oracle-receipts-v1"},
    "status": {"const": "unexecuted_evidence_only"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_pins": {"$ref": "#/$defs/oracle_input_pins"},
    "counts": {"$ref": "#/$defs/oracle_counts"},
    "future_protected_role_receipt_target": {"$ref": "#/$defs/future_target"},
    "tasks": {"type": "array", "minItems": 30, "maxItems": 30, "items": {"$ref": "#/$defs/task"}},
    "manifest_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "oracle_input_pins": {"type": "object", "additionalProperties": false, "required": ["benchmark_plan", "closure", "blocker_map"], "properties": {"benchmark_plan": {"$ref": "#/$defs/hash"}, "closure": {"$ref": "#/$defs/hash"}, "blocker_map": {"$ref": "#/$defs/hash"}}},
    "oracle_counts": {"type": "object", "additionalProperties": false, "required": ["tasks_in", "tasks_out", "task_ids_distinct", "oracle_cells_intended", "oracle_cells_executed", "f4_f6_cells_intended", "f4_f6_cells_executed", "gaps"], "properties": {"tasks_in": {"const": 30}, "tasks_out": {"const": 30}, "task_ids_distinct": {"const": 30}, "oracle_cells_intended": {"const": 160}, "oracle_cells_executed": {"const": 0}, "f4_f6_cells_intended": {"const": 75}, "f4_f6_cells_executed": {"const": 0}, "gaps": {"const": 160}}},
    "future_target": {"type": "object", "additionalProperties": false, "required": ["status", "target", "executed", "by_family"], "properties": {"status": {"const": "planning_target_not_evidence"}, "target": {"const": 25}, "executed": {"const": 0}, "by_family": {"const": {"F-4": {"roles": ["observed", "proposed"], "target": 10}, "F-5": {"roles": ["legacy", "canonical"], "target": 10}, "F-6": {"roles": ["explained_source"], "target": 5}}}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["task_id", "family", "mode", "source_path", "source_blob_oid", "intended_oracles", "leakage_group_id", "closure_status", "oracle_cells"], "properties": {"task_id": {"type": "string", "pattern": "^slice-0001/f[1-6]-0[1-5]$"}, "family": {"enum": ["F-1", "F-2", "F-3", "F-4", "F-5", "F-6"]}, "mode": {"enum": ["author", "edit", "repair", "review", "migrate", "explain"]}, "source_path": {"type": "string", "minLength": 1}, "source_blob_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "intended_oracles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "leakage_group_id": {"$ref": "#/$defs/hash"}, "closure_status": {"const": "computed_not_sealed"}, "oracle_cells": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}}}},
    "cell": {"type": "object", "additionalProperties": false, "required": ["predicate", "status", "authority", "receipt_ref", "receipt_sha256"], "properties": {"predicate": {"type": "string", "minLength": 1}, "status": {"const": "not_run"}, "authority": {"const": null}, "receipt_ref": {"const": null}, "receipt_sha256": {"const": null}}}
  }
}
